{
  "expo": {
    "name": "Luthifer",
    "slug": "luthifer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "luthifer",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.jomarton.luthifer",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jomarton.luthifer",
      "adaptiveIcon": {
        "backgroundColor": "#4A2C1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Luthifer",
      "shortName": "Luthifer",
      "description": "Luthier helper tools: nut slot spacing with an equal gap between every string.",
      "themeColor": "#4A2C1A",
      "backgroundColor": "#4A2C1A",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4A2C1A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/Luthifer/app"
    },
    "backgroundColor": "#4A2C1A"
  }
}
