{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "docs",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--directory",
        "docs"
      ],
      "port": 8090
    },
    {
      "name": "site",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve-site.mjs"
      ],
      "port": 4173,
      "url": "http://localhost:4173"
    }
  ]
}
